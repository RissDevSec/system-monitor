# Telegram bot credentials (required; see README for setup instructions)
BOT_KEY=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# Paths inside the container (should match the volumes in docker-compose.yaml;
# leave these two as they are).
PROCFS_PATH=/host/proc
DISK_PATH=/host/root

# Alert thresholds (percentage, 1-100)
CPU_THRESHOLD=80
RAM_THRESHOLD=80
DISK_THRESHOLD=80

# How often to check, in seconds
CHECK_INTERVAL=60

# How often to remind you, in seconds, while something stays in warning
# (14400 = 4 hours). 0 turns reminders off.
REPEAT_INTERVAL=14400

# Set to 1 for verbose DEBUG logs (default: 0)
DEBUG=0
